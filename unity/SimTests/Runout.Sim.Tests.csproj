<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the ride physics (godot/sim, shared with Godot) + Assets/Runout/Config outside Unity, for fast headless physics tests
       (the Godot slope_stress / playground-suite role). LangVersion 9 = what Unity 6 compiles, so code that
       builds here builds in Unity. Run: dotnet run - -project unity/SimTests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <DefineConstants>$(DefineConstants);RUNOUT_COMPAT</DefineConstants>
    <NoWarn>CS0162;CS0219;CS0168;CS0414</NoWarn>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Runout.Sim.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../godot/sim/**/*.cs" />
    <Compile Include="../Assets/Runout/Config/**/*.cs" />
    <Compile Include="../Assets/Runout/Levels/**/*.cs" />
    <Compile Include="../Assets/Runout/Rider/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
