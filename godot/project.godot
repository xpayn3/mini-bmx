; Engine configuration file.
config_version=5

[application]
config/name="Mini BMX"
config/description="Downhill & BMX riding on endless procedural trails."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
Tune="*res://scripts/core/tune.gd"
GameState="*res://scripts/core/game_state.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=false

[rendering]
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
