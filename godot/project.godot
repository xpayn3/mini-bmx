; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Runout"
config/description="Downhill & BMX riding on endless procedural trails."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Mini BMX"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/splash/logo.png"
config/icon="res://icon.svg"

[autoload]

CrashLog="*res://scripts/core/crash_log.gd"
Settings="*res://scripts/core/settings.gd"
Tune="*res://scripts/core/tune.gd"
GameState="*res://scripts/core/game_state.gd"
Steam="*res://scripts/core/steam.gd"

[debug]

file_logging/max_log_files=20

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Mini BMX"

[editor_plugins]

enabled=PackedStringArray("res://addons/level_builder/plugin.cfg", "res://addons/land_lab/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/Barlow-Bold.ttf"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
camera/depth_of_field/depth_of_field_bokeh_quality=2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
global_illumination/sdfgi/frames_to_converge=1
environment/defaults/default_clear_color=Color(0.66, 0.84, 0.92, 1)
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true

[shader_globals]

grass_win={
"type": "sampler2D",
"value": ""
}
grass_win_info={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
puddle_wake={
"type": "sampler2D",
"value": ""
}
puddle_wake_info={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
rut_tex={
"type": "sampler2D",
"value": ""
}
rut_win={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
rut_far_tex={
"type": "sampler2D",
"value": ""
}
rut_far_win={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
rut_ctr={
"type": "vec4",
"value": Vector4(0, 0, 12, 20)
}
atm_wind={
"type": "vec4",
"value": Vector4(0.8, 0.6, 0, 1)
}
atm_pusher={
"type": "vec4",
"value": Vector4(0, -10000, 0, 0)
}
cam_see={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cam_eye={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
deco_fade={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
atm_cloud={
"type": "vec4",
"value": Vector4(0, 0, 0.42, 1)
}
grime={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
mud_col={
"type": "color",
"value": Color(0.35, 0.235, 0.133, 1)
}
grime_dust={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
rider_trim={
"type": "float",
"value": 0.0
}
grime_age={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
grime_wf={
"type": "vec4",
