<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>MiniBMX</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- the terrain math is hot: JIT-optimise every configuration (Godot runs the Debug build from the editor) -->
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
